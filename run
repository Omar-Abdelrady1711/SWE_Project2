#!/usr/bin/env bash
set -euo pipefail

# choose python
if command -v python3 >/dev/null 2>&1; then PY=python3; else PY=python; fi

# repo root = this script's dir
ROOT="$(cd "$(dirname "$0")" && pwd -P)"

cmd="${1:-}"
if [[ -z "$cmd" ]]; then
  echo "Usage: ./run {install|test|URL_FILE}" >&2
  exit 1
fi

case "$cmd" in
    install)
      "$PY" -m pip install -U pip setuptools wheel
      pushd "$ROOT" >/dev/null
      "$PY" -m pip install -e .
      "$PY" -m pip install ".[dev]"
      popd >/dev/null
    ;;

    test)
    # Run pytest with coverage, capture output quietly
    set +e
    OUT=$("$PY" -m pytest --cov=acemcli --cov-report=term-missing 2>&1)
    RC=$?
    set -e

    # ---- Parse test counts ----
    # total collected (available when not using -q)
    COLLECTED=$(printf "%s\n" "$OUT" | grep -oE 'collected [0-9]+ items' | awk '{print $2}')
    # number passed (from summary line: "X passed")
    PASSED=$(printf "%s\n" "$OUT" | grep -oE '[0-9]+ passed' | awk '{print $1}')

    # Fallbacks (in case formats differ)
    [[ -z "$PASSED" ]] && PASSED=0
    [[ -z "$COLLECTED" ]] && COLLECTED="$PASSED"

    # ---- Parse coverage ----
    # Grab trailing % from the TOTAL row of the coverage table
    COV=$(printf "%s\n" "$OUT" \
      | grep -E '^[[:space:]]*TOTAL[[:space:]]+' \
      | awk '{print $NF}' \
      | tr -d '%' \
      | tail -n1)
    [[ -z "$COV" ]] && COV=0

    # ---- Print exactly one line as required by spec ----
    echo "${PASSED}/${COLLECTED} test cases passed. ${COV}% line coverage achieved."

    # ---- Exit code policy: success only if tests OK AND coverage >= 80 ----
    if [[ "$RC" -eq 0 && "$COV" -ge 80 ]]; then
      exit 0
    else
      exit 1
    fi
    ;;
esac
